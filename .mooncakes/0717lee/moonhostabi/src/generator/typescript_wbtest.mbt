///|
fn generator_fixture_abi() -> @model.HostAbi {
  @model.HostAbi::{
    schema_version: 1,
    imports: [
      @model.AbiFunction::{
        module_name: Some("moonbit:ffi"),
        name: "make_closure",
        params: [@model.FuncRef, @model.ExternRef],
        results: [@model.FuncRef],
      },
      @model.AbiFunction::{
        module_name: Some("host"),
        name: "echo",
        params: [@model.ExternRef],
        results: [@model.ExternRef],
      },
      @model.AbiFunction::{
        module_name: Some("env"),
        name: "now",
        params: [],
        results: [@model.F64],
      },
    ],
    exports: [
      @model.AbiFunction::{
        module_name: None,
        name: "add",
        params: [@model.I32, @model.I32],
        results: [@model.I32],
      },
    ],
    types: [],
    features: ["moonbit.make_closure"],
  }
}

///|
fn generate_draft(
  abi : @model.HostAbi,
) -> GenerationResult raise @contract.ContractError {
  generate_typescript_adapter(abi, @contract.create_contract_draft(abi))
}

///|
test "generator emits exact deterministic v2 contract draft" {
  let abi = generator_fixture_abi()
  let hash = @lockfile.host_abi_sha256(abi)
  let generated = generate_draft(abi)
  let expected = "{\"schemaVersion\":2,\"abiSha256\":\"" +
    hash +
    "\",\"externrefs\":{\"imports[host.echo].params[0]\":\"TExtern0\",\"imports[host.echo].results[0]\":\"TExtern1\",\"imports[moonbit:ffi.make_closure].params[1]\":\"TExtern2\"},\"imports\":[]}\n"
  inspect(generated.abi_sha256, content=hash)
  inspect(generated.contract, content=expected)
  inspect(generated.diagnostics.length(), content="0")
  let manifest = decode_generation_manifest(generated.manifest)
  inspect(manifest.abi_fingerprint(), content=hash)
  inspect(
    manifest.file_sha256("moonhostabi.contract.json") ==
    Some(
      @lockfile.sha256_hex(@encoding.encode(@encoding.UTF8, generated.contract)),
    ),
    content="true",
  )
  inspect(generate_draft(abi).contract, content=expected)
}

///|
test "generator emits exact typed ESM and throwing host stubs" {
  let abi = generator_fixture_abi()
  let hash = @lockfile.host_abi_sha256(abi)
  let generated = generate_draft(abi)
  let expected = "// Generated by MoonHostABI. Do not edit.\n// ABI SHA-256: " +
    hash +
    "\n\n" +
    (
      #|export type HostImports<TExtern0 = unknown, TExtern1 = unknown, TExtern2 = unknown> = {
      #|  "env": {
      #|    "now": () => number;
      #|  };
      #|  "host": {
      #|    "echo": (arg0: TExtern0) => TExtern1;
      #|  };
      #|  "moonbit:ffi": {
      #|    "make_closure": (arg0: (...args: unknown[]) => unknown, arg1: TExtern2) => (...args: unknown[]) => unknown;
      #|  };
      #|};
      #|
      #|export type ModuleExports = {
      #|  "add": (arg0: number, arg1: number) => number;
      #|};
      #|
      #|export function makeMoonBitClosure<TContext>(
      #|  fn: (...args: unknown[]) => unknown,
      #|  context: TContext,
      #|): (...args: unknown[]) => unknown {
      #|  return (...args: unknown[]) => fn(context, ...args);
      #|}
      #|
      #|export function createHostImports<TExtern0 = unknown, TExtern1 = unknown, TExtern2 = unknown>(): HostImports<TExtern0, TExtern1, TExtern2> {
      #|  return {
      #|    "env": {
      #|      "now": () => {
      #|        throw new Error("MHA_ADAPTER_MISMATCH: missing host import env.now ()->(f64)");
      #|      },
      #|    },
      #|    "host": {
      #|      "echo": (_arg0) => {
      #|        throw new Error("MHA_ADAPTER_MISMATCH: missing host import host.echo (externref)->(externref)");
      #|      },
      #|    },
      #|    "moonbit:ffi": {
      #|      "make_closure": (fn, context) => makeMoonBitClosure(fn, context),
      #|    },
      #|  };
      #|}
      #|
      #|function assertHostImports<TExtern0, TExtern1, TExtern2>(
      #|  imports: HostImports<TExtern0, TExtern1, TExtern2>,
      #|): void {
      #|  if (typeof imports !== "object" || imports === null) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[env.now]");
      #|  }
      #|  const root = imports as unknown as Record<string, unknown>;
      #|  if (!Object.prototype.hasOwnProperty.call(root, "env")) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[env.now]");
      #|  }
      #|  const module0 = root["env"];
      #|  if (typeof module0 !== "object" || module0 === null) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[env.now]");
      #|  }
      #|  const module0Record = module0 as Record<string, unknown>;
      #|  if (!Object.prototype.hasOwnProperty.call(module0Record, "now") ||
      #|    typeof module0Record["now"] !== "function") {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: host import imports[env.now] must be a function");
      #|  }
      #|  if (!Object.prototype.hasOwnProperty.call(root, "host")) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[host.echo]");
      #|  }
      #|  const module1 = root["host"];
      #|  if (typeof module1 !== "object" || module1 === null) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[host.echo]");
      #|  }
      #|  const module1Record = module1 as Record<string, unknown>;
      #|  if (!Object.prototype.hasOwnProperty.call(module1Record, "echo") ||
      #|    typeof module1Record["echo"] !== "function") {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: host import imports[host.echo] must be a function");
      #|  }
      #|  if (!Object.prototype.hasOwnProperty.call(root, "moonbit:ffi")) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[moonbit:ffi.make_closure]");
      #|  }
      #|  const module2 = root["moonbit:ffi"];
      #|  if (typeof module2 !== "object" || module2 === null) {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: missing or invalid host import imports[moonbit:ffi.make_closure]");
      #|  }
      #|  const module2Record = module2 as Record<string, unknown>;
      #|  if (!Object.prototype.hasOwnProperty.call(module2Record, "make_closure") ||
      #|    typeof module2Record["make_closure"] !== "function") {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: host import imports[moonbit:ffi.make_closure] must be a function");
      #|  }
      #|}
      #|
      #|function assertModuleExports(
      #|  exports: WebAssembly.Exports,
      #|): void {
      #|  const root = exports as unknown as Record<string, unknown>;
      #|  if (!Object.prototype.hasOwnProperty.call(root, "add") ||
      #|    typeof root["add"] !== "function") {
      #|    throw new Error("MHA_ADAPTER_MISMATCH: module export exports[add] must be a function");
      #|  }
      #|}
      #|
      #|export async function instantiate<TExtern0 = unknown, TExtern1 = unknown, TExtern2 = unknown>(
      #|  bytes: BufferSource,
      #|  imports: HostImports<TExtern0, TExtern1, TExtern2>,
      #|): Promise<ModuleExports> {
      #|  assertHostImports(imports);
      #|  const result = await WebAssembly.instantiate(bytes, imports);
      #|  assertModuleExports(result.instance.exports);
      #|  return result.instance.exports as unknown as ModuleExports;
      #|}
      #|
    )
  inspect(generated.typescript, content=expected)
  inspect(generated.typescript.contains("any"), content="false")
}

///|
test "explicit contract applies a safe externref generic" {
  let abi = generator_fixture_abi()
  let hash = @lockfile.host_abi_sha256(abi)
  let contract_text = "{\"schemaVersion\":2,\"abiSha256\":\"" +
    hash +
    "\",\"externrefs\":{\"imports[host.echo].params[0]\":\"HostToken\",\"imports[host.echo].results[0]\":\"HostToken\",\"imports[moonbit:ffi.make_closure].params[1]\":\"HostToken\"},\"imports\":[]}\n"
  let contract = @contract.decode_contract(abi, contract_text)
  let generated = generate_typescript_adapter(abi, contract)
  inspect(
    generated.typescript.contains("HostImports<HostToken = unknown>"),
    content="true",
  )
  inspect(generated.contract == contract_text, content="true")
}

///|
test "typed GC refs and v128 produce diagnostics instead of TypeScript fiction" {
  let abi = @model.HostAbi::{
    schema_version: 1,
    imports: [
      @model.AbiFunction::{
        module_name: Some("host"),
        name: "typed",
        params: [@model.TypedRef("type[0]", false)],
        results: [],
      },
    ],
    exports: [
      @model.AbiFunction::{
        module_name: None,
        name: "vector",
        params: [],
        results: [@model.V128],
      },
    ],
    types: [],
    features: [],
  }
  let generated = generate_draft(abi)
  inspect(generated.typescript, content="")
  inspect(generated.manifest, content="")
  inspect(generated.diagnostics.length(), content="2")
  inspect(generated.diagnostics[0].code, content="MHA_PROJECT_UNREPRESENTABLE")
  inspect(
    generated.diagnostics[0].path,
    content="imports[host.typed].params[0]",
  )
  inspect(generated.diagnostics[1].path, content="exports[vector].results[0]")
}

///|
test "generator rejects a validated contract bound to another ABI" {
  let abi = generator_fixture_abi()
  let other = @model.HostAbi::{
    schema_version: 1,
    imports: [],
    exports: [],
    types: [],
    features: [],
  }
  let contract = @contract.create_contract_draft(other)
  let rejected = try generate_typescript_adapter(abi, contract) catch {
    _ => true
  } noraise {
    _ => false
  }
  inspect(rejected, content="true")
}

///|
test "special JavaScript property keys are emitted as computed own properties" {
  let escaped_export_name = "odd\"\\\nname"
  let abi = @model.HostAbi::{
    schema_version: 1,
    imports: [
      @model.AbiFunction::{
        module_name: Some("__proto__"),
        name: "__proto__",
        params: [],
        results: [],
      },
    ],
    exports: [
      @model.AbiFunction::{
        module_name: None,
        name: "__proto__",
        params: [],
        results: [],
      },
      @model.AbiFunction::{
        module_name: None,
        name: escaped_export_name,
        params: [],
        results: [],
      },
    ],
    types: [],
    features: [],
  }
  let generated = generate_draft(abi)
  inspect(generated.diagnostics.length(), content="0")
  inspect(
    generated.typescript.contains("    [\"__proto__\"]: {"),
    content="true",
  )
  inspect(
    generated.typescript.contains("      [\"__proto__\"]: () => {"),
    content="true",
  )
  inspect(
    generated.typescript.contains(
      "Object.prototype.hasOwnProperty.call(root, \"__proto__\")",
    ),
    content="true",
  )
  inspect(
    generated.typescript.contains(
      "Object.prototype.hasOwnProperty.call(module0Record, \"__proto__\")",
    ),
    content="true",
  )
  let proto_export_check =
    #|  if (!Object.prototype.hasOwnProperty.call(root, "__proto__") ||
    #|    typeof root["__proto__"] !== "function") {
    #|    throw new Error("MHA_ADAPTER_MISMATCH: module export exports[__proto__] must be a function");
    #|  }
    #|
  inspect(generated.typescript.contains(proto_export_check), content="true")
  let escaped_export_key = contract_json_string(escaped_export_name)
  inspect(
    generated.typescript.contains(
      "Object.prototype.hasOwnProperty.call(root, \{escaped_export_key})",
    ),
    content="true",
  )
  inspect(
    generated.typescript.contains(
      "typeof root[\{escaped_export_key}] !== \"function\"",
    ),
    content="true",
  )
}

///|
test "module export preflight follows canonical export order" {
  let abi = @model.HostAbi::{
    schema_version: 1,
    imports: [],
    exports: [
      @model.AbiFunction::{
        module_name: None,
        name: "zeta",
        params: [],
        results: [],
      },
      @model.AbiFunction::{
        module_name: None,
        name: "beta",
        params: [],
        results: [],
      },
    ],
    types: [],
    features: [],
  }
  let generated = generate_draft(abi)
  let ordered_checks =
    #|  if (!Object.prototype.hasOwnProperty.call(root, "beta") ||
    #|    typeof root["beta"] !== "function") {
    #|    throw new Error("MHA_ADAPTER_MISMATCH: module export exports[beta] must be a function");
    #|  }
    #|  if (!Object.prototype.hasOwnProperty.call(root, "zeta") ||
    #|    typeof root["zeta"] !== "function") {
    #|    throw new Error("MHA_ADAPTER_MISMATCH: module export exports[zeta] must be a function");
    #|  }
    #|
  inspect(generated.typescript.contains(ordered_checks), content="true")
}

///|
test "duplicate JavaScript import and export keys fail closed" {
  let abi = @model.HostAbi::{
    schema_version: 1,
    imports: [
      @model.AbiFunction::{
        module_name: Some("host"),
        name: "same",
        params: [@model.I32],
        results: [],
      },
      @model.AbiFunction::{
        module_name: Some("host"),
        name: "same",
        params: [@model.F64],
        results: [],
      },
    ],
    exports: [
      @model.AbiFunction::{
        module_name: None,
        name: "same",
        params: [],
        results: [@model.I32],
      },
      @model.AbiFunction::{
        module_name: None,
        name: "same",
        params: [],
        results: [@model.I64],
      },
    ],
    types: [],
    features: [],
  }
  let generated = generate_draft(abi)
  inspect(generated.typescript, content="")
  inspect(generated.diagnostics.length(), content="2")
  inspect(generated.diagnostics[0].code, content="MHA_ADAPTER_MISMATCH")
  inspect(generated.diagnostics[0].path, content="imports[host.same]")
  inspect(generated.diagnostics[1].path, content="exports[same]")
}
