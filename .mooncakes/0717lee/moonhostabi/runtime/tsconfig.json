{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["generated/**/*.ts", "node/**/*.ts"]
}
